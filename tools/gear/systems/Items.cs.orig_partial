    public static readonly List<GemDef> Gems = BuildGems();

    private static List<GemDef> BuildGems()
    {
        var l = new List<GemDef>();
        string[] tiers = { "碎裂的", "無瑕的", "璀璨的" };
        float[] m = { 1f, 2f, 3.2f };
        void G(string id, string name, Godot.Color c, (Stat, float) w, (Stat, float) a, (Stat, float) j)
        {
            for (int t = 0; t < 3; t++)
                l.Add(new GemDef { Id = $"{id}{t + 1}", Name = tiers[t] + name, Tier = t + 1, Color = c, Icon = "gem_" + id,
                    Weapon = (w.Item1, w.Item2 * m[t]), Armor = (a.Item1, a.Item2 * m[t]), Jewel = (j.Item1, j.Item2 * m[t]) });
        }
        G("ruby", "紅燼石", new Godot.Color(0.95f, 0.2f, 0.15f), (Stat.DmgOverpower, 12), (Stat.LifePct, 2), (Stat.ResFire, 8));
        G("sapphire", "霜藍晶", new Godot.Color(0.25f, 0.5f, 1f), (Stat.CritDmg, 6), (Stat.DmgReduction, 1), (Stat.ResFrost, 8));
        G("topaz", "雷黃玉", new Godot.Color(1f, 0.8f, 0.2f), (Stat.DmgBasic, 8), (Stat.MaxResource, 4), (Stat.ResLightning, 8));
        G("emerald", "瘴綠玉", new Godot.Color(0.3f, 0.9f, 0.3f), (Stat.DmgVuln, 6), (Stat.Thorns, 30), (Stat.ResPoison, 8));
        G("amethyst", "影紫晶", new Godot.Color(0.65f, 0.3f, 0.95f), (Stat.DmgDot, 6), (Stat.Healing, 3), (Stat.ResShadow, 8));
        G("skull", "亡者顱骨", new Godot.Color(0.85f, 0.83f, 0.75f), (Stat.LifeOnKill, 6), (Stat.Armor, 30), (Stat.ResAll, 2.5f));
        return l;
    }

    public static AspectDef Aspect(string id) => Aspects.FirstOrDefault(a => a.Id == id);
    public static UniqueDef UniqueOf(string id) => Uniques.FirstOrDefault(u => u.Id == id);
    public static GemDef Gem(string id) => Gems.FirstOrDefault(g => g.Id == id);

    public static (Stat s, float v) GemBonus(GemDef g, ItemKind k) =>
        k == ItemKind.Weapon ? g.Weapon : (k is ItemKind.Amulet or ItemKind.Ring ? g.Jewel : g.Armor);

    // ───────────────────────── generation ─────────────────────────

    private static int Tier(int power) => Math.Clamp(power / 125, 0, 4);

    /// <summary>Rolls an item. <paramref name="cls"/> biases weapons and affixes toward the player's class.</summary>
    public static Item Generate(int power, Rarity rarity, ClassId cls, ItemKind? kind = null, Random rng = null)
    {
        rng ??= Rng.R;
        power = Math.Clamp(power, 5, MaxPower);
        var k = kind ?? RollKind(rng);
        if (rarity == Rarity.Unique)
        {
            var cands = Uniques.Where(u => (u.Class < 0 || u.Class == (int)cls) && (kind == null || u.Kind == kind)).ToList();
            if (cands.Count > 0) return MakeUnique(Rng.Pick(cands, rng), power, rng);
            rarity = Rarity.Legendary;
        }

        var it = new Item { Kind = k, Rarity = rarity, Power = power, ReqLevel = Math.Clamp(power / 10 - 2, 1, 50) };
        FillBase(it, cls, rng);
        int n = rarity switch { Rarity.Common => 0, Rarity.Magic => rng.Next(1, 3), Rarity.Rare => 3, _ => 4 };
        RollAffixes(it, n, cls, rng);

        if (rarity == Rarity.Legendary)
        {
            var asp = Aspects.Where(a => a.Kinds.Contains(k) && (a.Class < 0 || a.Class == (int)cls)).ToList();
            var a2 = Rng.Pick(asp, rng);
            it.Aspect = a2.Id;
            it.AspectRoll = (float)rng.NextDouble();
        }
        if (k is ItemKind.Weapon or ItemKind.Helm or ItemKind.Chest or ItemKind.Pants or ItemKind.Amulet or ItemKind.Ring)
        {
            double socketChance = rarity >= Rarity.Rare ? 0.35 : 0.15;
            if (rng.NextDouble() < socketChance) it.Sockets = (k == ItemKind.Weapon || k == ItemKind.Chest) && rng.NextDouble() < 0.3 ? 2 : 1;
        }
        NameItem(it, rng);
        it.Value = SellValue(it);
        return it;
    }

    private static ItemKind RollKind(Random rng)
    {
        // weapons a little more common than any single armour slot
        int r = rng.Next(100);
        if (r < 18) return ItemKind.Weapon;
        if (r < 30) return ItemKind.Helm;
        if (r < 44) return ItemKind.Chest;
        if (r < 56) return ItemKind.Gloves;
        if (r < 68) return ItemKind.Pants;
        if (r < 80) return ItemKind.Boots;
        if (r < 88) return ItemKind.Amulet;
        return ItemKind.Ring;
    }

    private static void FillBase(Item it, ClassId cls, Random rng)
    {
        int t = Tier(it.Power);
        if (it.Kind == ItemKind.Weapon)
        {
            int wc = (int)cls;
            it.WeaponClass = wc;
            it.Name = WeaponNames[wc][t];
            it.Icon = WeaponIcons[wc];
            it.Aps = WeaponAps[wc];
            float avg = WeaponAvg(it.Power) / it.Aps * (0.94f + 0.12f * (float)rng.NextDouble());
            it.DmgMin = MathF.Round(avg * 0.8f);
            it.DmgMax = MathF.Round(avg * 1.2f);
        }
        else
        {
            var b = Bases[it.Kind];
            it.Name = b.names[t];
            it.Icon = b.icon;
            float k = it.Kind switch { ItemKind.Chest => 1f, ItemKind.Pants => 0.72f, ItemKind.Helm => 0.6f, ItemKind.Gloves => 0.42f, ItemKind.Boots => 0.42f, _ => 0f };
            it.Armor = (int)MathF.Round((8 + it.Power * 0.9f) * k * (0.92f + 0.16f * (float)rng.NextDouble()));
        }
    }

    public static float WeaponAvg(int power) => 5f + power * 0.42f;

    private static void RollAffixes(Item it, int n, ClassId cls, Random rng, HashSet<Stat> exclude = null)
    {
        var main = Names.MainStat(cls);
        var pool = Pools.Where(p => p.Kinds.Contains(it.Kind) && it.Affixes.All(a => a.Stat != p.S) && (exclude == null || !exclude.Contains(p.S))).ToList();
        for (int i = 0; i < n && pool.Count > 0; i++)
        {
            float total = pool.Sum(p => Weight(p, main, cls));
            float r = (float)rng.NextDouble() * total;
            Pool pick = pool[^1];
            foreach (var p in pool) { r -= Weight(p, main, cls); if (r <= 0) { pick = p; break; } }
            pool.Remove(pick);
            it.Affixes.Add(RollAffix(pick, it, rng));
        }
    }

    public static float Weight(Pool p, Stat main, ClassId cls)
    {
        float w = p.Weight;
        if (p.S == main) w *= 4f;                                    // the class's own attribute shows up far more often
        else if (p.S is Stat.Str or Stat.Int or Stat.Dex or Stat.Wil) w *= 0.35f;
        if (p.S == Stat.MinionDmg && cls != ClassId.Soulbinder && cls != ClassId.Pactbinder && cls != ClassId.Wildsoul) w = 0f;
        if (p.S == Stat.DmgOverpower && cls != ClassId.Emberblade && cls != ClassId.Forgebody && cls != ClassId.Wildsoul && cls != ClassId.Lampknight) w *= 0.3f;
        return w;
    }

    public static Affix RollAffix(Pool p, Item it, Random rng)
    {
        float span = p.Lo + (p.Hi - p.Lo) * (it.Power / (float)MaxPower);
        float v = span * (0.72f + 0.28f * (float)rng.NextDouble());
        bool greater = it.Rarity >= Rarity.Legendary && it.Power >= 300 && rng.NextDouble() < 0.08;
        if (greater) v *= 1.5f;
        v = StatInfo.IsPct(p.S) ? MathF.Round(v * 10f) / 10f : MathF.Max(1, MathF.Round(v));
        return new Affix { Stat = p.S, Value = v, Greater = greater };
    }

    private static void NameItem(Item it, Random rng)
    {
        string baseName = it.Name;
        switch (it.Rarity)
        {
            case Rarity.Magic: it.Name = Rng.Pick(MagicPrefix, rng) + baseName; break;
            case Rarity.Rare: it.Name = Rng.Pick(RareA, rng) + Rng.Pick(RareB, rng) + "・" + baseName; break;
            case Rarity.Legendary: it.Name = Aspect(it.Aspect).Name + "之" + baseName; break;
        }
    }

    private static Item MakeUnique(UniqueDef u, int power, Random rng)
    {
        var it = new Item { Kind = u.Kind, Rarity = Rarity.Unique, Power = power, ReqLevel = Math.Clamp(power / 10 - 2, 1, 50), Unique = u.Id };
        FillBase(it, u.Class >= 0 ? (ClassId)u.Class : ClassId.Emberblade, rng);
        if (u.Kind == ItemKind.Weapon) { it.DmgMin = MathF.Round(it.DmgMin * 1.12f); it.DmgMax = MathF.Round(it.DmgMax * 1.12f); }
        it.Name = u.Name;
        it.Icon = u.Icon;
        float scale = 0.35f + 0.65f * power / MaxPower;
        foreach (var (s, lo, hi) in u.Affixes)
        {
            float v = (lo + (hi - lo) * (float)rng.NextDouble()) * (s == Stat.SkillRanks ? 1f : scale);
            v = StatInfo.IsPct(s) ? MathF.Round(v * 10f) / 10f : MathF.Max(1, MathF.Round(v));
            it.Affixes.Add(new Affix { Stat = s, Value = v });
        }
        it.Value = SellValue(it);
        return it;
    }

    public static Item MakeGem(string gemId)
    {
        var g = Gem(gemId);
        return new Item { Kind = ItemKind.Gem, GemId = g.Id, Name = g.Name, Icon = g.Icon, Rarity = (Rarity)Math.Min(g.Tier, 2), Value = 40 * g.Tier * g.Tier, Power = g.Tier };
    }

    public static Item RandomGem(int level, Random rng = null)
    {
        rng ??= Rng.R;
        int tier = level < 15 ? 1 : (level < 32 ? (rng.NextDouble() < 0.3 ? 2 : 1) : (rng.NextDouble() < 0.25 ? 3 : 2));
        var c = Gems.Where(g => g.Tier == tier).ToList();
        return MakeGem(Rng.Pick(c, rng).Id);
    }

    public static int SellValue(Item it)
    {
        float m = it.Rarity switch { Rarity.Common => 1f, Rarity.Magic => 2f, Rarity.Rare => 4f, Rarity.Legendary => 10f, _ => 16f };
        return (int)(m * (6 + it.Power * 0.6f));
    }

    /// <summary>Starting weapon for a new character.</summary>
    public static Item Starter(ClassId cls)
    {
        var it = Generate(10, Rarity.Common, cls, ItemKind.Weapon);
        return it;
    }

    // ─────────────────── crafting (blacksmith / occultist) ───────────────────

    public static int UpgradeGoldCost(Item it) => (int)((30 + it.Power * 1.4f) * (1 + it.Upgrade * 0.6f) * (1 + (int)it.Rarity * 0.4f));
    public static int UpgradeScrapCost(Item it) => 2 + it.Upgrade * 2 + it.Power / 80;
    public static int UpgradeDustCost(Item it) => it.Upgrade >= 4 ? it.Upgrade : 0;
    public static int UpgradeCoreCost(Item it) => it.Upgrade >= 8 ? 1 : 0;

    public static (int scrap, int dust, int cores) SalvageYield(Item it)
    {
        int baseAmt = 1 + it.Power / 80;
        return it.Rarity switch
        {
            Rarity.Common => (baseAmt, 0, 0),
            Rarity.Magic => (baseAmt + 1, 0, 0),
            Rarity.Rare => (baseAmt + 2, 1 + it.Power / 200, 0),
            _ => (baseAmt + 3, 2 + it.Power / 150, 1),
        };
    }

    public static int EnchantGoldCost(Item it, int timesEnchanted) => (int)((120 + it.Power * 4f) * MathF.Pow(1.5f, timesEnchanted));
    public const int EnchantDustCost = 3;

    /// <summary>Rerolls one affix into a different stat. Returns the candidate (caller commits it).</summary>
    public static Affix RerollAffix(Item it, int index, ClassId cls, Random rng = null)
    {
        rng ??= Rng.R;
        var main = Names.MainStat(cls);
        var pool = Pools.Where(p => p.Kinds.Contains(it.Kind) && it.Affixes.All(a => a.Stat != p.S)).ToList();
        if (pool.Count == 0) return null;
        float total = pool.Sum(p => Weight(p, main, cls));
        float r = (float)rng.NextDouble() * total;
        Pool pick = pool[^1];
        foreach (var p in pool) { r -= Weight(p, main, cls); if (r <= 0) { pick = p; break; } }
        return RollAffix(pick, it, rng);
    }

    public static int ImprintGoldCost(Item it) => 400 + it.Power * 8;
}

/// <summary>
/// Builds BBCode tooltip text for items (rarity colour, stats, comparison deltas). The body takes the tooltip's own
/// running-text size; the [font_size] tags written here already carry the final size (UiTheme.Fs: text scale and the
/// 20 px floor), so callers show the string as it is and must NOT pass it through UiTheme.Bb again.
/// </summary>
public static class ItemText
{
    /// <summary>Design sizes (px at 1080p): the item's name, and the big damage / armour figure.</summary>
    private const int NameSize = 28, FigureSize = 34;

    private static string Hex(Godot.Color c) => c.ToHtml(false);

    public static string Tooltip(Item it, Item equipped = null, int playerLevel = 99, bool showCompare = true)
    {
        var sb = new StringBuilder();
        var rc = Palette.Rarity(it.Rarity);
        sb.Append($"[font_size={UiTheme.Fs(NameSize)}][color=#{Hex(rc)}]{it.Name}{(it.Upgrade > 0 ? $" +{it.Upgrade}" : "")}[/color][/font_size]\n");

        if (it.Kind == ItemKind.Gem)
        {
            var g = ItemDb.Gem(it.GemId);
            sb.Append($"[color=#{Hex(Palette.TextDim)}]寶石（{g.Tier} 階）[/color]\n\n");
            sb.Append($"武器：{StatInfo.Format(g.Weapon.s, g.Weapon.v)}\n防具：{StatInfo.Format(g.Armor.s, g.Armor.v)}\n飾品：{StatInfo.Format(g.Jewel.s, g.Jewel.v)}\n");
            sb.Append($"\n[color=#{Hex(Palette.TextDim)}]在物品欄中右鍵點擊，再選擇有空插槽的裝備進行鑲嵌。[/color]\n");
            sb.Append($"[color=#{Hex(Palette.Gold)}]售價 {it.Value}[/color]");
            return sb.ToString();
        }

        string kind = it.Kind == ItemKind.Weapon && it.WeaponClass >= 0 ? ItemDb.WeaponTypeNames[it.WeaponClass] : Names.Kind(it.Kind);
        sb.Append($"[color=#{Hex(rc)}]{Names.Rarity(it.Rarity)}{kind}[/color]   [color=#{Hex(Palette.TextDim)}]物品強度 {it.Power}[/color]\n");

        if (it.Kind == ItemKind.Weapon)
        {
            float dps = it.AvgDmg * it.Aps;
            sb.Append($"\n[font_size={UiTheme.Fs(FigureSize)}]{dps:0.0}[/font_size] 每秒傷害");
            if (showCompare && equipped != null) sb.Append(Delta(dps - equipped.AvgDmg * equipped.Aps, "0.0"));
            float up = it.BaseMul;
            sb.Append($"\n[color=#{Hex(Palette.TextDim)}]傷害 {it.DmgMin * up:0}–{it.DmgMax * up:0}　每秒攻擊 {it.Aps:0.00}[/color]\n");
        }
        else if (it.Armor > 0)
        {
            sb.Append($"\n[font_size={UiTheme.Fs(FigureSize)}]{it.Armor * it.BaseMul:0}[/font_size] 護甲");
            if (showCompare && equipped != null) sb.Append(Delta(it.Armor * it.BaseMul - equipped.Armor * equipped.BaseMul, "0"));
            sb.Append('\n');
        }

        sb.Append('\n');
        foreach (var a in it.Affixes)
        {
            float v = it.Eff(a);
            string star = a.Tempered ? $"[color=#{Hex(Palette.Gold)}]⚒[/color] " : a.Greater ? $"[color=#{Hex(Palette.Ember)}]✦[/color] " : "◆ ";
            sb.Append($"{star}{StatInfo.Format(a.Stat, v)}");
            if (showCompare && equipped != null)
            {
                var o = equipped.Affixes.FirstOrDefault(x => x.Stat == a.Stat);
                float ov = o == null ? 0 : equipped.Eff(o);
                if (MathF.Abs(v - ov) > 0.05f) sb.Append(Delta(v - ov, StatInfo.IsPct(a.Stat) ? "0.#" : "0", StatInfo.IsPct(a.Stat) ? "%" : ""));
            }
            sb.Append('\n');
        }
        if (showCompare && equipped != null)
        {
            foreach (var o in equipped.Affixes.Where(o => it.Affixes.All(a => a.Stat != o.Stat)))
                sb.Append($"[color=#{Hex(Palette.Bad)}]　失去 {StatInfo.Format(o.Stat, equipped.Eff(o))}[/color]\n");
        }

        if (it.Aspect != null)
        {
            var asp = ItemDb.Aspect(it.Aspect);
            if (asp != null) sb.Append($"\n[color=#{Hex(Palette.Rarity(Rarity.Legendary))}]✹ {string.Format(asp.Desc, asp.Value(it.AspectRoll))}[/color]\n");
        }
        if (it.Unique != null)
        {
            var u = ItemDb.UniqueOf(it.Unique);
            if (u != null)
            {
                sb.Append($"\n[color=#{Hex(Palette.Rarity(Rarity.Unique))}]✹ {u.Desc}[/color]\n");
                sb.Append($"\n[i][color=#{Hex(Palette.TextDim)}]「{u.Flavor}」[/color][/i]\n");
            }
        }
        if (it.Sockets > 0)
        {
            sb.Append('\n');
            for (int i = 0; i < it.Sockets; i++)
            {
                if (i < it.Gems.Count)
                {
                    var g = ItemDb.Gem(it.Gems[i]);
                    var b = ItemDb.GemBonus(g, it.Kind);
                    sb.Append($"[color=#{Hex(g.Color)}]◉ {g.Name}：{StatInfo.Format(b.s, b.v)}[/color]\n");
                }
                else sb.Append($"[color=#{Hex(Palette.TextDim)}]○ 空插槽[/color]\n");
            }
        }
        sb.Append('\n');
        if (it.ReqLevel > 1)
        {
            var c = playerLevel >= it.ReqLevel ? Palette.TextDim : Palette.Bad;
            sb.Append($"[color=#{Hex(c)}]需要等級 {it.ReqLevel}[/color]　");
        }
        sb.Append($"[color=#{Hex(Palette.Gold)}]售價 {it.Value}[/color]");
        return sb.ToString();
    }

    private static string Delta(float d, string fmt, string suffix = "")
    {
        if (MathF.Abs(d) < 0.05f) return "";
        var c = d > 0 ? Palette.Good : Palette.Bad;
        return $" [color=#{Hex(c)}]({(d > 0 ? "+" : "")}{d.ToString(fmt)}{suffix})[/color]";
    }
}
