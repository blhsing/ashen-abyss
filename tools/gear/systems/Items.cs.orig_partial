    // affix pools: stat, low value, high value (at max power), allowed kinds
    public sealed record Pool(Stat S, float Lo, float Hi, ItemKind[] Kinds, float Weight = 1f);
    public static readonly List<Pool> Pools = new()
    {
        new(Stat.Str, 4, 62, AnyKind, 0.5f), new(Stat.Int, 4, 62, AnyKind, 0.5f), new(Stat.Dex, 4, 62, AnyKind, 0.5f), new(Stat.Wil, 4, 62, AnyKind, 0.5f),
        new(Stat.MaxLife, 12, 640, new[] { ItemKind.Helm, ItemKind.Chest, ItemKind.Pants, ItemKind.Boots, ItemKind.Gloves }, 1.4f),
        new(Stat.LifePct, 2, 11, new[] { ItemKind.Helm, ItemKind.Chest, ItemKind.Ring, ItemKind.Amulet }),
        new(Stat.Armor, 10, 480, new[] { ItemKind.Helm, ItemKind.Chest, ItemKind.Pants, ItemKind.Boots }),
        new(Stat.ResAll, 2, 13, Defense), new(Stat.ResFire, 5, 30, Defense, 0.4f), new(Stat.ResFrost, 5, 30, Defense, 0.4f),
        new(Stat.ResLightning, 5, 30, Defense, 0.4f), new(Stat.ResPoison, 5, 30, Defense, 0.4f), new(Stat.ResShadow, 5, 30, Defense, 0.4f),
