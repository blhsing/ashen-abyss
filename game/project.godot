; Engine configuration file.
config_version=5

[application]

config/name="燼淵 Ashen Abyss"
config/version="0.4.1"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="AshenAbyss"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/engine.log"
file_logging/max_log_files=10

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/mode.editor=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="AshenAbyss"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

hero_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
focus_pos={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
